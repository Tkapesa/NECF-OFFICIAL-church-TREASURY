# Local development
# Leave DATABASE_URL unset to use SQLite locally.
# For production hosting, set DATABASE_URL to your PostgreSQL connection string.
# Example for Render/Neon: postgresql://user:password@host:5432/dbname?sslmode=require

DATABASE_URL=
JWT_SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
